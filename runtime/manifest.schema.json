{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "status",
    "default_engine_version",
    "release_base_url",
    "engines"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "repository": {
      "const": "jedaqu/android_release_doctor"
    },
    "status": {
      "enum": [
        "draft",
        "published"
      ]
    },
    "default_engine_version": {
      "type": "string"
    },
    "release_base_url": {
      "type": "string",
      "format": "uri"
    },
    "engines": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "published",
          "release_tag",
          "assets"
        ],
        "properties": {
          "published": {
            "type": "boolean"
          },
          "release_tag": {
            "type": "string"
          },
          "assets": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "linux-x64",
              "linux-arm64",
              "macos-x64",
              "macos-arm64",
              "windows-x64",
              "windows-arm64"
            ],
            "properties": {
              "linux-x64": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "file",
                  "sha256"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9a-fA-F]{64}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              "linux-arm64": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "file",
                  "sha256"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9a-fA-F]{64}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              "macos-x64": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "file",
                  "sha256"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9a-fA-F]{64}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              "macos-arm64": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "file",
                  "sha256"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9a-fA-F]{64}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              "windows-x64": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "file",
                  "sha256"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9a-fA-F]{64}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              },
              "windows-arm64": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "file",
                  "sha256"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9a-fA-F]{64}$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
